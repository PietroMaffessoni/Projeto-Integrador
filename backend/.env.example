# Copie para .env e ajuste. Todos os valores abaixo já são os padrões do código.

# --- Servidor --------------------------------------------------------------
PORTA=3333
HOST=0.0.0.0

# --- Fonte de eventos (CLAUDE.md, seções 1 e 13) ---------------------------
# mqtt      = maquete física ou sensores reais publicando no broker
# simulador = gerador interno de eventos, sem nenhum fio
# A troca é transparente para o resto do sistema.
FONTE_EVENTOS=mqtt

# --- MQTT ------------------------------------------------------------------
MQTT_URL=mqtt://localhost:1883
MQTT_USUARIO=
MQTT_SENHA=
PREFIXO_MQTT=maua/estacionamento

# --- Persistência ----------------------------------------------------------
# postgres = histórico real (obrigatório para previsão e anomalias)
# memoria  = tudo em RAM, para rodar sem banco numa demonstração
PERSISTENCIA=postgres
DATABASE_URL=postgres://vagas:vagas@localhost:5432/vagas

# --- Saúde do controlador --------------------------------------------------
# Sem heartbeat por este tempo, as vagas do controlador viram OFFLINE.
TIMEOUT_HEARTBEAT_MS=120000
CONTROLADOR_PADRAO=placa-01

# --- Rotas de demonstração -------------------------------------------------
# Habilita POST /demo/... para forçar o estado de uma vaga pela API.
# Nunca ligar em produção.
PERMITIR_DEMO=false

NIVEL_LOG=info
