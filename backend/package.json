{
  "name": "vagas-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST, assinante MQTT e servidor WebSocket do monitoramento de vagas",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "dev:demo": "cross-env FONTE_EVENTOS=simulador PERSISTENCIA=memoria PERMITIR_DEMO=true tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/servidor.js",
    "migrar": "tsx src/dados/migrar.ts",
    "semear-historico": "tsx src/dados/semear-historico.ts",
    "verificar-tipos": "tsc --noEmit",
    "test": "tsx --test src/**/*.teste.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "mqtt": "^5.10.3",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
